<form action="/rnode/<%= host %>/<%= port %>/" method="post" target="_blank">
  <input type="hidden" name="password" value="<%= password %>">
  <button class="btn btn-primary" type="submit">Open Bhaskera</button>
</form>
<p class="text-muted">It opens in a new tab and stays available until this session ends. Jobs you start from it keep running on their own.</p>
