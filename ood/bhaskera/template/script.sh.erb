#!/usr/bin/env bash
# Runs inside the session job, as the user. $host, $port and $password come from before.sh. The user sets nothing, and no module is loaded:
# the installer wrote where Bhaskera is installed, and this script sets what the Lmod module would set.

ROOT="__ROOT__"
[[ -x "$ROOT/venv/bin/bhaskera-dashboard" ]] || { echo "Bhaskera is not installed at $ROOT on $(hostname)" >&2; exit 1; }
export BHASKERA_HOME="$ROOT" BHASKERA_DIR="$ROOT/src" BHASKERA_KIT="$ROOT/share/kit" BHASKERA_OBSERVABILITY="$ROOT/observability"
export VIRTUAL_ENV="$ROOT/venv" PATH="$ROOT/venv/bin:$PATH" MLFLOW_ALLOW_FILE_STORE=true
export BHASKERA_QUICKSTART="${BHASKERA_QUICKSTART:-$(dirname "$ROOT")/quickstart}"
# The cluster profile (partitions, GPUs per node): the one in the kit, unless the site sets another.
[[ -n "${BHASKERA_CLUSTER_PROFILE:-}" ]] || export BHASKERA_CLUSTER_PROFILE="$(ls "$BHASKERA_KIT"/clusters/*.yaml 2>/dev/null | head -1)"

# The account jobs are charged to: the user's login name, which is their Slurm account (a user may set another with SLURM_ACCOUNT).
export SLURM_ACCOUNT="${SLURM_ACCOUNT:-$USER}"

# Where submit.sh, the recipes and the checkpoints live: the user's own copy of the shared kit, made on first use.
export BHASKERA_WORKDIR="${BHASKERA_WORKDIR:-${SCRATCH:-$HOME}/bhaskera-runs}"
if [[ ! -f "$BHASKERA_WORKDIR/submit.sh" ]]; then
    mkdir -p "$BHASKERA_WORKDIR" && cp -rn "$BHASKERA_KIT"/. "$BHASKERA_WORKDIR"/
fi
cd "$BHASKERA_WORKDIR"

# Only the portal's own Open button carries this token; the page refuses every other request.
export BHASKERA_HUB_TOKEN="${password:?the portal did not give a password}"
# The path the portal puts in front of the page: MLflow's pages are served under it, inside the same tab.
export BHASKERA_EXTERNAL_PREFIX="__PROXY__/${host}/${port}"

echo "Bhaskera on ${host}:${port} (account ${SLURM_ACCOUNT}, folder ${BHASKERA_WORKDIR})"
exec bhaskera-dashboard portal --bind 0.0.0.0 --hub-port "${port:?the portal did not give a port}"
